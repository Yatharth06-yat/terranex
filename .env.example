# ESP32-CAM IP shown in Serial Monitor
CAMERA_CAPTURE_URL=http://192.168.1.11/capture

# Ultralytics downloads yolo11n.pt automatically on first launch if absent.
# You can replace this with a custom YOLO detection checkpoint (.pt).
MODEL_PATH=yolo11n.pt

# COCO class 0 is person. Keep this set to 0 for human-only detections.
PERSON_CLASS_ID=0
YOLO_CONFIDENCE=0.35
YOLO_IMAGE_SIZE=640

# Main ESP32 telemetry and command endpoints
ROVER_ID=ROVER_1
